# Telegram
TELEGRAM_TOKEN=your_bot_token_here

# T-Invest API (из личного кабинета T-Invest → API-токен)
TINKOFF_API_TOKEN=your_tinkoff_token_here

# ИИ-провайдер (по умолчанию Gemini — бесплатно)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here      # aistudio.google.com — бесплатно
# OPENAI_API_KEY=                        # альтернатива
# ANTHROPIC_API_KEY=                     # альтернатива

# Алерты
ALERT_RSI_OVERSOLD=30
ALERT_RSI_OVERBOUGHT=70
ALERT_PRICE_CHANGE_PCT=3.0
ALERT_VOLUME_SPIKE=3.0

# Расписание (время московское)
MORNING_BRIEF_TIME=08:30

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
